{
  "name": "@trinity-nexus/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Supabase schema, Row Level Security policies and the types generated from them.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local > src/generated/database.types.ts",
    "clean": "rm -rf node_modules *.tsbuildinfo"
  },
  "devDependencies": {
    "@trinity-nexus/tsconfig": "workspace:*",
    "supabase": "2.109.1",
    "typescript": "catalog:"
  }
}
