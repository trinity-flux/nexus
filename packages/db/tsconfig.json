{
  "extends": "@trinity-nexus/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    // This package runs in Node only: the migrations are read off disk and
    // applied to an in-process Postgres. Nothing here reaches a browser.
    "types": ["node", "vitest/globals"],
    "module": "ESNext",
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src", "vitest.config.ts"]
}
