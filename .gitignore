# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Tooling caches
.turbo/
coverage/
.vite/
*.tsbuildinfo

# Environment. Only .env.example is committed: it documents the variables
# without carrying a single value.
.env
.env.*
!.env.example

# Supabase CLI local state
supabase/.branches/
supabase/.temp/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Only the root lockfile is committed. A stray one inside a package means
# somebody ran npm or pnpm from the wrong directory, and it would pin a second,
# conflicting dependency tree.
apps/*/pnpm-lock.yaml
packages/*/pnpm-lock.yaml
**/package-lock.json

# Legacy asset from the 2017 prototype
developer.png
