    "clean": "rm -rf dist node_modules coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@reduxjs/toolkit": "2.12.0",
    "@supabase/supabase-js": "2.110.8",
    "@trinity-nexus/db": "workspace:*",
    "@trinity-nexus/ui": "workspace:*",
    "dompurify": "3.4.12",
    "lucide-react": "1.27.0",
    "marked": "18.0.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "9.3.0",
    "react-router": "8.3.0",
    "redux-observable": "3.0.0-rc.3",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@trinity-nexus/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "rollup-plugin-visualizer": "7.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
