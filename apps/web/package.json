{
  "name": "@trinity-nexus/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Trinity Nexus community portal, deployed to GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
