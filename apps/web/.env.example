# Copy to .env and fill in. Only VITE_-prefixed variables reach the browser
# bundle, and everything in this file does: treat all of it as public.

# Where the app is served from. GitHub Pages serves this repository as a
# project page, hence the sub-path. Set to "/" when a custom domain is in play.
VITE_BASE_PATH=/trinitynexus.github.io/

# Canonical origin, used for SEO tags and the generated sitemap.
VITE_SITE_URL=https://trinity-flux.github.io

# Which adapters the dependency container wires up.
#   memory   — in-memory repositories, seeded with sample content. No network.
#   supabase — the real backend. Requires the two variables below.
VITE_DATA_SOURCE=memory

# Supabase project credentials. The anon key is public by design: every table
# is guarded by Row Level Security, which is what actually authorises a request.
# The service_role key must NEVER appear here, or anywhere in this repository.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Feature flags.
# Lets unauthenticated visitors post in categories that opt in. Off by default:
# turning it on without moderation in place invites spam.
VITE_FEATURE_ANONYMOUS_POSTING=false
